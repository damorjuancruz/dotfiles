{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:informe-pdf-iea": "user-invocable-only",
    "anthropic-skills:morning": "off",
    "anthropic-skills:slides-ejecutivas-iea": "user-invocable-only"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "cc-plugin-diff@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "cc-plugin-telemetry@builtin": false,
    "posthog@posthog": true
  },
  "extraKnownMarketplaces": {
    "posthog": {
      "source": {
        "source": "github",
        "repo": "PostHog/ai-plugin"
      }
    }
  },
  "language": "Español",
  "feedbackDrafts": "notify",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "crossSessionInbound": "hold",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
